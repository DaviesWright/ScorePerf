{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hr-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "YOUR_HYPERDRIVE_ID",
      "localConnectionString": "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
    }
  ],

  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "scoreview-docs"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],

  "queues": {
    "producers": [
      {
        "queue": "hr-jobs-queue",
        "binding": "JOBS_QUEUE"
      }
    ]
  },

  "workflows": [
    {
      "name": "performance-review-workflow",
      "binding": "REVIEW_WORKFLOW",
      "class_name": "PerformanceReviewWorkflow"
    }
  ]
}

