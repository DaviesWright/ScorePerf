{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hr-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d1468c75b19f437b994c969eb1fa2b41",
      "localConnectionString": "postgresql://neondb_owner:npg_yEVhg3OA9qKI@ep-steep-bonus-zak8wuuy.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "ab360608196c48c5b8958d5e6ce7d8ff"
    }
  ],

  "queues": {
    "consumers": [
      {
        "queue": "hr-jobs-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "dead_letter_queue": "hr-jobs-dlq",
        "max_retries": 3
      }
    ]
  },

  "workflows": [
    {
      "name": "performance-review-workflow",
      "binding": "REVIEW_WORKFLOW",
      "class_name": "PerformanceReviewWorkflow"
    }
  ]
}

